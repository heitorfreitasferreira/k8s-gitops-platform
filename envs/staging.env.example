# STAGING — exemplo tangivel (commitado). Copie para staging.env (gitignored),
# preencha valores SINTETICOS e sele com:
#   kubectl create secret generic todolist-auth -n todolist-staging \
#     --from-env-file=envs/staging.env --dry-run=client -o yaml | \
#   kubeseal --cert clusters/local/sealed-secrets/cert.pem --scope strict \
#     --namespace todolist-staging --name todolist-auth --format yaml \
#   > k8s/overlays/staging/sealed-auth.yaml
# Mesmo fluxo para postgres (chaves POSTGRES_* -> sealed-postgres.yaml).
# NUNCA commitar o .env preenchido: so .env.example + SealedSecret cifrado.
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_KEY=
CLEANUP_TOKEN=
