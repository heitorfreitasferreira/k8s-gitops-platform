# Template. setup-host.sh escreve minio-console-ingress.yaml com o IP derivado
# do CIDR/rede libvirt local. O arquivo renderizado e ignorado pelo Git.
apiVersion: v1
kind: Service
metadata:
  name: minio-console
  namespace: default
spec:
  ports:
    - name: console
      port: 9001
      targetPort: 9001
---
apiVersion: v1
kind: Endpoints
metadata:
  name: minio-console
  namespace: default
subsets:
  - addresses:
      - ip: ${MINIO_IP}
    ports:
      - name: console
        port: 9001
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: minio-console
  namespace: default
spec:
  ingressClassName: traefik
  rules:
    - host: minio.localhost
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: minio-console
                port:
                  number: 9001
