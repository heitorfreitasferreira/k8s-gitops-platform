# Copie para terraform.tfvars e ajuste se necessario.

cluster_name  = "talos"
talos_version = "1.13.3"

# O script setup-host.sh detecta URI, rede, CIDR, pool, firmware, chave SSH e
# gera terraform.tfvars local. Valores abaixo sao apenas referencia.
# libvirt_uri  = "qemu:///system"
# network_name = "default"
# network_cidr = "<detectado da rede libvirt>"
# firmware_path = "<detectado no host>"
# minio_root_password = "<gerada pelo setup-host.sh>"
# minio_ssh_pubkey = "<lida de ~/.ssh/*.pub>"

# Enderecos sao derivados do CIDR detectado, usando host numbers reservados:
# controlplane_hostnum_start = 10
# worker_hostnum_start       = 11
# minio_hostnum              = 20

# Para trocar as extensoes da imagem, regenere o schematic na Image Factory e
# aponte o ID aqui:
# image_schematic_id = "<novo-id>"
