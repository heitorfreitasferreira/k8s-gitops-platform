{
  "uid": "vms-hosts",
  "title": "VMs / Hosts",
  "tags": [
    "hosts",
    "talos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{job=~\"node-exporter|minio-node\"}, nodename)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "VM: $node",
      "collapsed": false,
      "repeat": "node",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "custom": {
                "fillOpacity": 10,
                "lineWidth": 1
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=~\"node-exporter|minio-node\",mode=\"idle\"}[5m]) and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"}))",
              "legendFormat": "CPU",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Memoria",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "custom": {
                "fillOpacity": 10,
                "lineWidth": 1
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=~\"node-exporter|minio-node\"} / node_memory_MemTotal_bytes{job=~\"node-exporter|minio-node\"} and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"})",
              "legendFormat": "Memoria",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Disco",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "custom": {
                "fillOpacity": 10,
                "lineWidth": 1
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "100 * (1 - node_filesystem_avail_bytes{job=~\"node-exporter|minio-node\",device!=\"none\",fstype!~\"tmpfs|overlay|squashfs|ramfs\"} / node_filesystem_size_bytes{job=~\"node-exporter|minio-node\",device!=\"none\",fstype!~\"tmpfs|overlay|squashfs|ramfs\"} and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"})",
              "legendFormat": "{{mountpoint}}",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Load average",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "fillOpacity": 10,
                "lineWidth": 1
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "node_load1{job=~\"node-exporter|minio-node\"} and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"}",
              "legendFormat": "load1",
              "refId": "A"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "node_load5{job=~\"node-exporter|minio-node\"} and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"}",
              "legendFormat": "load5",
              "refId": "B"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "node_load15{job=~\"node-exporter|minio-node\"} and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"}",
              "legendFormat": "load15",
              "refId": "C"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Rede recebida",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "custom": {
                "fillOpacity": 10,
                "lineWidth": 1
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "irate(node_network_receive_bytes_total{job=~\"node-exporter|minio-node\",device=~\"enp1s0|bond0\"}[5m]) and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"}",
              "legendFormat": "{{device}}",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Rede transmitida",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 0
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "custom": {
                "fillOpacity": 10,
                "lineWidth": 1
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "irate(node_network_transmit_bytes_total{job=~\"node-exporter|minio-node\",device=~\"enp1s0|bond0\"}[5m]) and on(instance) node_uname_info{job=~\"node-exporter|minio-node\",nodename=\"$node\"}",
              "legendFormat": "{{device}}",
              "refId": "A"
            }
          ]
        }
      ]
    }
  ]
}
